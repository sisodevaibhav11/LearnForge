# LearnForge Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learnforge?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/learnforge?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=learnforge_super_secure_jwt_secret_change_me_in_production
JWT_EXPIRE=7d

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000
